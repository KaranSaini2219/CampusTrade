# Required
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campustrade-nitj?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-vercel-project.vercel.app
ALLOWED_EMAIL_DOMAINS=nitj.ac.in

# Optional: persistent listing images. Without these, uploads use local disk.
